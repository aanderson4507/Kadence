# Copy this file to .env (never commit .env). Every value below is a placeholder.
# Setup guide: docs/team-setup.md

# --- Option A: local PostgreSQL 17 (default for day-to-day development) ---
# Replace YOUR_LOCAL_PASSWORD with the password you chose when installing PostgreSQL.
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/kadence_dev?schema=public"

# --- Option B: shared Neon cloud database (approved migrations only) ---
# Get the real URL privately from the team lead. Never paste it into git, issues or PRs.
# Use it only to run `npm run db:deploy`, then switch back to Option A.
# DATABASE_URL="postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST.neon.tech/kadence_dev?sslmode=require"

# Port for the Express API (npm run dev:api). Vite proxies /api to it.
API_PORT=3001
