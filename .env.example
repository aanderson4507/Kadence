# Copy this file to .env (never commit .env).

# Local development database (each teammate runs their own PostgreSQL 17).
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/kadence_dev?schema=public"

# Shared cloud development database (Neon free tier). Get the URL from the team lead;
# only point DATABASE_URL at it to apply approved migrations (npm run db:deploy).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/kadence_dev?sslmode=require"

# Port for the Express API (npm run dev:api). Vite proxies /api to it.
API_PORT=3001
